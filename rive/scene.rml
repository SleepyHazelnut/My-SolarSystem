            <KeyedObject objectId="0:28">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="120" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- 同理：Hover 也把猫猫嘴显式置 0，避免残留 -->
            <KeyedObject objectId="0:32">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="120" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- 星环悬停摆幅加大：0.8245 → 0.9845。起点取 0.8245，
                 让从 Idle 切过来时状态机平滑插值、不跳 -->
            <KeyedObject objectId="0:20">
                <!-- 同 Idle：环心 x/y 钉回 8.1/5.7 -->
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="8.1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="8.1" frame="120" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="14">
