                        <CubicEaseInterpolator x1="0" y1="0" x2="0.2" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:27">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:28">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- 猫猫嘴在 Idle 必须显式置 0：Rive 不复位「未被当前动画驱动」的属性，
                 否则从 Clicked 切回来时猫嘴会残留不消失 -->
            <KeyedObject objectId="0:32">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- 星环小幅左右摆：基准 0.6545rad(37.5°)，摆幅 ±0.15rad(≈±8.6°)，
                 一右一左正好一个呼吸周期 -->
            <KeyedObject objectId="0:20">
                <!-- x/y 也钉回 8.1/5.7：Clicked 会让环心绕小圆摆，中途被打断时 Rive 不复位，
                     环会永久停在偏心位置 -->
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="8.1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="8.1" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="5.7" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="5.7" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0.6545" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.8045" frame="45" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.6545" frame="90" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.5045" frame="135" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.6545" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <!-- scale 也钉回 0.37：Clicked 会胀到 0.47，不钉的话点完一次环就一直偏大 -->
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.37" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.37" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.37" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0.37" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Hover：上浮放大，只把嘴换成圆嘴（眼睛保持豆豆） -->
        <LinearAnimation duration="120" loopValue="loop" name="Hover" id="0:41">
            <KeyedObject objectId="0:70">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="309.78" interpolationType="cubic">
