            <KeyedObject objectId="0:28">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="72" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:32">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="72" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- 星环点击反应：先胀出去（scale 0.37→0.47），再绕环心转满一整圈（8→88 帧），
                 最后收回并做一段衰减余摆。
                 转 360° 用 80 帧 = 4.5°/帧：环上 20 个火尖角距 18°，
                 超过 1/4 周期就会触发「车轮效应」频闪，看着像火尖原地乱跳。
                 转圈期间环心绕半径 6 的小圆摆动 —— 环近乎旋转对称，
                 纯自转时画面里没有可追踪的参照物。 -->
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="13">
                    <!-- x：环心绕小圆走。只在极值点放关键帧：缓动两端速度本为 0，正好对应正弦极值；
                         在过零点也放帧会被压成「停一下再走」，轨迹变成卡顿的菱形 -->
                    <KeyFrameDouble value="8.1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="8.1" frame="8" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="2.1" frame="28" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="14.1" frame="48" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="2.1" frame="68" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="14.1" frame="88" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="8.1" frame="114" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="14">
                    <!-- y：与 x 的极值点错开 10 帧（= 1/4 周期），两者正交合起来才是圆 -->
                    <KeyFrameDouble value="5.7" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="5.7" frame="8" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="11.7" frame="18" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.3" frame="38" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="11.7" frame="58" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="-0.3" frame="78" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="11.7" frame="98" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="5.7" frame="114" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="15">
                    <KeyFrameDouble value="0.6545" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.30" y1="0" x2="0.20" y2="1"/>
                    </KeyFrameDouble>
                    <!-- 前 8 帧先胀开，角度不动 -->
                    <KeyFrameDouble value="0.6545" frame="8" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.30" y1="0" x2="0.20" y2="1"/>
                    </KeyFrameDouble>
                    <!-- 一整圈：0.6545 + 2π = 6.9377。终点用 hold：下一帧要回 0.6545，
                         线性会插出 3.796rad(217°) 这个错误角度，高刷屏上会闪一帧 -->
                    <KeyFrameDouble value="6.9377" frame="88" interpolationType="hold"/>
                    <KeyFrameDouble value="0.6545" frame="89" interpolationType="linear"/>
                    <!-- 衰减余摆：顺时针冲过头 → 反向回摆 → 归位。
                         刚转完的东西本来就该晃两下再停，直接定住像画面被冻住 -->
                    <KeyFrameDouble value="0.7545" frame="99" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.30" y1="0" x2="0.20" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.6165" frame="107" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.6545" frame="114" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.37" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.30" y1="0" x2="0.20" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.47" frame="8" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <!-- 转动期间小幅脉动，上限仍是 0.47：环胀得越大，内孔离太阳本体越远，
                         中间那圈空白就越宽 -->
                    <KeyFrameDouble value="0.445" frame="30" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.47" frame="52" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.452" frame="72" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.47" frame="88" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.37" frame="104" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.37" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.30" y1="0" x2="0.20" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.47" frame="8" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.445" frame="30" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.47" frame="52" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.452" frame="72" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.47" frame="88" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.37" frame="104" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <ImageAsset file="assets/sun/ring_outer.png" name="ringOuter" id="0:78"/>
    <ImageAsset file="assets/sun/sun_base.png" name="sunBody" id="0:61"/>
