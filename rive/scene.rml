    <ImageAsset file="assets/sun/eye_closed.png" name="eyeClosed" id="0:68"/>
    <ImageAsset file="assets/sun/mouth_flat.png" name="mouthFlat" id="0:72"/>
    <ImageAsset file="assets/sun/mouth_round.png" name="mouthRound" id="0:73"/>
    <ImageAsset file="assets/sun/cat_face.png" name="catFace" id="0:77"/>

    <!-- 眼睛跟随的两个数字，由宿主页面每帧写入（见 src/sun.js），Face/Look 节点绑着读。
         三处链接缺一不可：artboard 的 viewModelId、view model 的 defaultInstanceId、
         每个 instance 值的 viewModelPropertyId。
         运行时写入方式：r.viewModelInstance.number('lookX').value = 42 -->
    <ViewModel defaultInstanceId="0:100" name="Look" id="0:99">
        <ViewModelPropertyNumber name="lookX" id="0:101"/>
        <ViewModelPropertyNumber name="lookY" id="0:102"/>
        <ViewModelInstance exports="true" name="Instance" id="0:100">
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:101"/>
            <ViewModelInstanceNumber propertyValue="0" viewModelPropertyId="0:102"/>
        </ViewModelInstance>
    </ViewModel>

</Rive>
