<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" viewModelId="0:99" styleId="0:5" width="590" height="600" name="Artboard" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- 角色整体挂在一个 Node 上：位移/缩放/呼吸都作用在组上。
             坐标 (295,324) / scale 0.79 对应 sun-tuner 的 --x 50% --y 54% --k 0.79。
             绘制顺序：先声明 = 最上层 -->
        <Node x="295" y="324" scaleX="0.79" scaleY="0.79" name="Sun" id="0:70">
            <!-- 星环：单层正圆外环（无前后透视），Ring 是唯一压在太阳之上的图层。
                 origin 钉在内孔圆心，x/y 把环心对准太阳可见中心 (8.1,5.7)；
                 scale 0.37 → 内缘每侧切进太阳 ≈29 局部单位（屏幕 ≈23px）。
                 自转不转整圈，只在 Idle/Hover/Clicked 里小幅摆动
                 （对应 sun-tuner 的 ring-idle / ring-hover / ring-click）。 -->
            <Image x="8.1" y="5.7" originX="0.5146" originY="0.5244" scaleX="0.37" scaleY="0.37" rotation="0.6545" assetId="0:78" name="Ring" id="0:20"/>

            <!-- 五官单独成组：眼睛跟随鼠标时整体平移这一层 -->
            <Node x="0" y="4" scaleX="0.30" scaleY="0.30" name="Face" id="0:71">
              <!-- lookX/lookY 由宿主页面每帧写入（见 src/sun.js） -->
              <Node x="0" y="0" name="Look" id="0:93">
                <DataBindContext sourcePathIds="0:99-0:101" propertyKey="13"/>
                <DataBindContext sourcePathIds="0:99-0:102" propertyKey="14"/>
                <Image x="0" y="0" originX="0.5" originY="0.5" scaleX="1" scaleY="1" assetId="0:67" name="EyeDot" id="0:23"/>
                <Image x="0" y="0" originX="0.5" originY="0.5" scaleX="1" scaleY="1" opacity="0" assetId="0:68" name="EyeClosed" id="0:24"/>
                <Image x="0" y="0" originX="0.5" originY="0.5" scaleX="1" scaleY="1" assetId="0:72" name="MouthFlat" id="0:27"/>
                <Image x="0" y="0" originX="0.5" originY="0.5" scaleX="1" scaleY="1" opacity="0" assetId="0:73" name="MouthRound" id="0:28"/>
                <!-- 猫猫脸：整张图含猫眼+猫嘴。origin 钉在猫脸眼中点，scale 0.976 使其对齐原版眼中点 -->
                <Image x="-54.6" y="63.5" originX="0.4353" originY="0.4204" scaleX="0.976" scaleY="0.976" opacity="0" assetId="0:77" name="CatFace" id="0:32"/>
              </Node>
            </Node>

            <Image x="0" y="0" originX="0.5" originY="0.5" scaleX="0.30" scaleY="0.30" assetId="0:61" name="SunBody" id="0:21"/>
        </Node>

        <!-- 背景矩形铺满画板，只负责底色。画板本身收不到指针事件，命中区必须另做形状；
             放在这里声明才会画在角色之下 -->
        <Shape x="295" y="300" name="Background" id="0:6">
            <Rectangle width="590" height="600" name="Path" id="0:80"/>
            <Fill name="Fill" id="0:81">
                <SolidColor colorValue="FFFFF5E6" name="Color" id="0:82"/>
            </Fill>
        </Shape>

        <!-- 太阳本体命中区：只有指针落在太阳圆盘内才触发 hover/click。
             全透明填充在 Rive 里依然可命中，且遮挡是 opt-in，所以既看不出来也不挡别的。
             半径按太阳本体实测 ~130px；放静态位置，不随呼吸移动，避免贴边抖动。 -->
        <Shape x="301" y="328" name="SunHit" id="0:95">
            <Ellipse width="300" height="300" name="Path" id="0:96"/>
            <Fill name="Fill" id="0:97">
                <SolidColor colorValue="00FFFFFF" name="Color" id="0:98"/>
            </Fill>
        </Shape>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineBool name="hover" id="0:30" value="false"/>
            <StateMachineBool name="pressed" id="0:31" value="false"/>

            <!-- 指针事件只能挂在形状上，全部指向 SunHit。按下/抬起用 bool 而非 trigger：
                 trigger 只活一帧，会和 hover 抢同一帧而丢失 -->
            <StateMachineListenerSingle targetId="0:95" listenerTypeValue="enter" name="BGEnter" id="0:50">
                <ListenerBoolChange inputId="0:30" value="true"/>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:95" listenerTypeValue="exit" name="BGExit" id="0:51">
                <ListenerBoolChange inputId="0:30" value="false"/>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:95" listenerTypeValue="down" name="BGDown" id="0:52">
                <ListenerBoolChange inputId="0:31" value="true"/>
            </StateMachineListenerSingle>
            <StateMachineListenerSingle targetId="0:95" listenerTypeValue="up" name="BGUp" id="0:53">
                <ListenerBoolChange inputId="0:31" value="false"/>
            </StateMachineListenerSingle>

            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120" id="0:10"/>
                <ExitState x="400" y="-120" id="0:11"/>
                <EntryState id="0:9">
                    <StateTransition stateToId="0:12" id="0:15"/>
                </EntryState>
                <AnimationState x="200" y="200" animationId="0:40" stateName="Idle" id="0:12">
                    <StateTransition stateToId="0:14" id="0:16" duration="260" interpolationType="cubic">
                        <TransitionBoolCondition inputId="0:31" opValue="equal"/>
                    </StateTransition>
                    <StateTransition stateToId="0:13" id="0:17" duration="180" interpolationType="cubic">
                        <TransitionBoolCondition inputId="0:30" opValue="equal"/>
                        <TransitionBoolCondition inputId="0:31" opValue="notEqual"/>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="380" y="200" animationId="0:41" stateName="Hover" id="0:13">
                    <StateTransition stateToId="0:14" id="0:18" duration="260" interpolationType="cubic">
                        <TransitionBoolCondition inputId="0:31" opValue="equal"/>
                    </StateTransition>
                    <StateTransition stateToId="0:12" id="0:19" duration="180" interpolationType="cubic">
                        <TransitionBoolCondition inputId="0:30" opValue="notEqual"/>
                    </StateTransition>
                </AnimationState>
                <AnimationState x="560" y="200" animationId="0:42" stateName="Clicked" id="0:14">
                    <!-- 指针仍在太阳上 → 回圆嘴(Hover)；靠前故优先于下面那条 -->
                    <StateTransition stateToId="0:13" id="0:55" duration="240" interpolationType="cubic" enableExitTime="true" exitTime="1900">
                        <TransitionBoolCondition inputId="0:30" opValue="equal"/>
                        <TransitionBoolCondition inputId="0:31" opValue="notEqual"/>
                    </StateTransition>
                    <!-- 指针已离开 → 回原版豆豆眼(Idle) -->
                    <StateTransition stateToId="0:12" id="0:54" duration="380" interpolationType="cubic" enableExitTime="true" exitTime="1900">
                        <TransitionBoolCondition inputId="0:31" opValue="notEqual"/>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Idle：太阳呼吸 + 星环轻摆，中途眨一次眼；180 帧首尾同值无缝循环 -->
        <LinearAnimation duration="180" loopValue="loop" name="Idle" id="0:40">
            <KeyedObject objectId="0:70">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="324" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="317.5" frame="88" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="324" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.79" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.80185" frame="74" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.79" frame="180" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.79" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.78763" frame="100" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0.79" frame="180" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <!-- 眨眼：闭合 6 帧 → 保持 3 帧 → 张开 9 帧（张开比闭合长，眼睑抬起有惯性） -->
            <KeyedObject objectId="0:23">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="162" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="168" interpolationType="linear"/>
